# Copy this file to .env.production on your local machine and fill in real
# values. NEVER commit .env.production to git — it is gitignored.
#
# To upload to Render:
#   1. Render Dashboard → okupy-api → Environment
#   2. Click "Add from .env"
#   3. Paste the contents of your local .env.production
#   4. Choose "Save, rebuild, and deploy"
#
# The values live in Render's encrypted env store; nothing touches git.

AIML_API_KEY=
EXA_API_KEY=
COMPOSIO_API_KEY=
DATABASE_URL=
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=