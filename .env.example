# Example env. Copy to .env (local dev) or .env.production (Render upload)
# and fill in real values. Never commit a populated .env.

AIML_API_KEY=
EXA_API_KEY=
COMPOSIO_API_KEY=

# Postgres persistence (Neon recommended)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Photon iMessage credentials (legacy alias for SPECTRUM_PROJECT_*)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Spectrum iMessage credentials (canonical)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=