# Custom model builder — do not hardcode Opus.
# Swap the Anthropic key, base URL, and model per environment or per request.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OKUPY_MODEL=claude-sonnet-4-5
OKUPY_FALLBACK_MODEL=claude-haiku-4-5
OKUPY_AGENT_MODE=direct

# Google Gemini Omni (AI video)
GEMINI_API_KEY=
GEMINI_OMNI_MODEL=gemini-omni-flash-preview

# Daytona sandbox (slide screenshots)
DAYTONA_API_KEY=
DAYTONA_API_URL=

# Composio (Gmail + other app auth)
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=okupy-owner

# Photon Spectrum (iMessage DMs). TypeScript sidecar required.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_SIDECAR_URL=http://127.0.0.1:8789
PHOTON_SIDECAR_TOKEN=
PHOTON_HOME_CHANNEL=

# App
OKUPY_DATA_DIR=./jobs
OKUPY_PUBLIC_BASE_URL=http://localhost:8000
PORT=8000
